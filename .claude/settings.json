{
  "permissions": {
    "allow": [
      "Bash(pnpm rules:check)",
      "Bash(pnpm typecheck)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(find *)",
      "Bash(ls*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm rules:check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm typecheck 2>&1 | tail -20"
          }
        ]
      }
    ]
  }
}
